# Default: normalize line endings to LF in the repository
* text=auto eol=lf

# Shell scripts must always be LF (Docker/Linux)
*.sh text eol=lf

# Python files
*.py text eol=lf

# Config / text files
*.txt text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.cfg text eol=lf
*.ini text eol=lf
*.env text eol=lf
*.md text eol=lf

# Dockerfiles
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# Binary files — no conversion
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.mo binary
